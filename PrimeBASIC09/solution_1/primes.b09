PROCEDURE primes
REM BASIC09 odd-only Sieve of Eratosthenes for OS-9.
REM Uses a reduced 10,000 limit to fit typical 6809 BASIC09 systems.

DIM LIMIT,NHALF,NSQ:INTEGER
DIM I,J,COUNT,EXPECTED,VALID:INTEGER
DIM FLAGS(5000):INTEGER

LIMIT=10000
NHALF=INT((LIMIT-1)/2)
NSQ=INT((SQR(LIMIT)-1)/2)

FOR I=1 TO NSQ
  IF FLAGS(I)=0 THEN
    FOR J=2*I*(I+1) TO NHALF STEP 2*I+1
      FLAGS(J)=1
    NEXT J
  ENDIF
NEXT I

COUNT=1
FOR I=1 TO NHALF
  IF FLAGS(I)=0 THEN
    COUNT=COUNT+1
  ENDIF
NEXT I

EXPECTED=1229
VALID=0
IF COUNT=EXPECTED THEN
  VALID=1
ENDIF

IF VALID=1 THEN
  PRINT "boisy_basic09;1;0;1;algorithm=base,faithful=no"
ELSE
  PRINT "boisy_basic09;1;0;0;algorithm=base,faithful=no"
ENDIF

END
