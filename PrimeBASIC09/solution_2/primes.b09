PROCEDURE primes
REM BASIC09 odd-only Sieve of Eratosthenes.
REM Runs for ~5 seconds, reports pass count and elapsed time.

DIM LIMIT,NHALF,NSQ,I,J,COUNT,PASSES:REAL
DIM SH,SM,SS,ST,CH,CM,CS,CT,ELAPSED:INTEGER
DIM D$:STRING[19]
DIM FLAGS(499999):BOOLEAN

LIMIT=1000000.0
NHALF=(LIMIT-1)/2
NSQ=INT((SQR(LIMIT)-1)/2)

D$=DATE$
SH=VAL(MID$(D$,12,2))
SM=VAL(MID$(D$,15,2))
SS=VAL(MID$(D$,18,2))
ST=SH*3600+SM*60+SS

PASSES=0
ELAPSED=0

REPEAT
  FOR I=0 TO NHALF
    FLAGS(I)=FALSE
  NEXT I
  FOR I=1 TO NSQ
    IF FLAGS(I)=FALSE THEN
      FOR J=2*I*(I+1) TO NHALF STEP 2*I+1
        FLAGS(J)=TRUE
      NEXT J
    ENDIF
  NEXT I
  PASSES=PASSES+1
  D$=DATE$
  CH=VAL(MID$(D$,12,2))
  CM=VAL(MID$(D$,15,2))
  CS=VAL(MID$(D$,18,2))
  CT=CH*3600+CM*60+CS
  ELAPSED=CT-ST
UNTIL ELAPSED>=5

COUNT=1
FOR I=1 TO NHALF
  IF FLAGS(I)=FALSE THEN COUNT=COUNT+1
NEXT I

IF COUNT=78498.0 THEN
  PRINT "drpitre_basic09;"+STR$(PASSES)+";"+STR$(ELAPSED)+";1;algorithm=base,faithful=yes"
ELSE
  PRINT "drpitre_basic09;"+STR$(PASSES)+";"+STR$(ELAPSED)+";1;algorithm=base,faithful=no"
ENDIF

END
